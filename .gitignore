# Xcode
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
*.xcworkspace/xcuserdata/
xcuserdata/
DerivedData/
build/
*.xcuserstate

# Generated by XcodeGen (project is regenerated from project.yml)
Readr.xcodeproj/
App/Info.plist

# Swift Package Manager
.build/
.swiftpm/
# Root Package.resolved is ignored on purpose. The root Package.swift (ReadrKit)
# declares zero dependencies, so any root Package.resolved is empty or — after a
# Linux verification run — polluted with unrelated swift-crypto/swift-asn1 patch
# artifacts that must never ship. ZIPFoundation (declared in project.yml, the
# Xcode app target) is pinned deterministically via `exactVersion: "0.9.19"`, and
# the Xcode project/workspace itself is generated by XcodeGen and git-ignored
# above, so there is no committable resolved file to track here.
/Package.resolved

# macOS
.DS_Store

# Secrets / local config
*.env
secrets.plist

# Misc
*.log

# Python bytecode (scripts/)
__pycache__/
*.pyc

# Local build/derived-data output (signed builds, UI-test runs)
build-*/

# Working-tree collateral that must never reach the public repo: marketing
# mockups, research notes, beta checklists. These live in
# ~/Documents/readr-private. Listed here rather than relied on being
# untracked, because a broad `git add` will otherwise sweep them into a
# public commit — which is exactly what happened once.
/docs/MARKETING.html
/docs/marketing/
/docs/research/
/AGENTS.md
/v*-beta-notes.md

# Written by `swiftly use` in a checkout; the toolchain version is pinned in android/readrkit/build.gradle.kts
/.swift-version
