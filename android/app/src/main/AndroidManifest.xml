<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Provider requests go to the host the reader connected. Explicit model
         installation fetches public weights from their pinned sources; no
         question or book text enters that download path. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Listen with the screen off. The service is a media-playback one and
         nothing else: it exists for as long as a voice is reading and is
         stopped with it. The notification permission is asked for the first
         time Listen starts, and a reader who says no still gets the voice —
         a media-playback foreground service shows its notification either
         way, so refusing costs nothing but the shade's other messages. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- media3-common declares this for ExoPlayer's bandwidth meter, which
         nothing here builds: the sound is local Kokoro PCM playback and synthesis makes no
         network request (PRIVACY.md). Taken back out, so
         the app's permission list stays the one sentence it has always been. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- The one package this app ever asks about: AICore, which is what the
         phone's own model runs inside. Android 11+ hides the package list
         from an app that has not declared what it needs to see, and without
         this the on-device card would report "no AICore" on every phone that
         has it. Nothing else is queried, and nothing is launched. -->
    <queries>
        <package android:name="com.google.android.aicore" />
    </queries>

    <application
        android:name=".ReadrApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Readr">
        <!-- ML Kit needs the transport classes to initialize, but metrics must
             have no registered backend, persistence or scheduling path. Without
             discovery metadata DefaultScheduler rejects events before storage. -->
        <service android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery" tools:node="remove" />
        <service android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService" tools:node="remove" />
        <receiver android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver" tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Readr">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The voice's own service: it holds the media session, so the
             notification, the lock screen and a headset button reach the
             narration the reader started. `exported` because those buttons
             arrive from the system, and media3 routes ACTION_MEDIA_BUTTON
             through the same service. -->
        <service
            android:name=".ui.listen.NarrationService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!-- Where a headset's play/pause lands. media3 routes it to the
             session on the service above; declaring it is what gives the
             system a target to send `ACTION_MEDIA_BUTTON` to, so hardware controls keep working across
             sessions and process restarts. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
